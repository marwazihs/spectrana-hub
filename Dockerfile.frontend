# syntax=docker/dockerfile:1.7
#
# Next.js viewer image. Multi-stage so the runtime layer carries only the
# standalone server bundle (~100MB) — no source, no node_modules, no bun.
#
# Build args:
#   - BUN_VERSION (default 1.3): pinned via image tag for reproducibility.
#     1.3+ required: the lockfile format used by the host bun (>=1.2) is
#     unreadable by 1.1 (InvalidLockfileVersion in CI). Bump in lockstep
#     with the host bun if you regenerate bun.lock.
# Runtime expectations (passed at `docker compose run` time, NOT baked in):
#   - HUB_API_BASE_URL: server-side Hub URL (Docker DNS, e.g. http://hub:8000)
#   - HUB_INTERNAL_TOKEN: shared secret with Hub (≥32 bytes)
#   - HUB_COOKIE_SECURE: "0" for local http, unset/"1" for prod https
#
# Build-time env vars (NEXT_PUBLIC_*) are baked into the bundle by `next build`
# and must be passed via --build-arg, not at runtime. We surface only the one
# the viewer reads from the browser: the reports origin (iframe src).

ARG BUN_VERSION=1.3

# --- Stage 1: install deps -------------------------------------------------
FROM oven/bun:${BUN_VERSION}-alpine AS deps

WORKDIR /app
COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile

# --- Stage 2: build --------------------------------------------------------
FROM oven/bun:${BUN_VERSION}-alpine AS build

ARG NEXT_PUBLIC_HUB_REPORTS_DOMAIN
ENV NEXT_PUBLIC_HUB_REPORTS_DOMAIN=${NEXT_PUBLIC_HUB_REPORTS_DOMAIN}

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN bun run build

# --- Stage 3: runtime ------------------------------------------------------
# Slim node image — the standalone build ships its own node_modules subset
# and runs `node server.js`. No bun needed at runtime.
FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app

# `output: 'standalone'` produces:
#   .next/standalone/   <- minimal node server + transitive deps
#   .next/static/       <- prebuilt static assets (must be served at /_next/static)
#   public/             <- public assets
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000

# server.js is generated by `next build` under output: 'standalone'.
CMD ["node", "server.js"]
