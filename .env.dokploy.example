# Dokploy → Compose app → Environment. Paste, then replace every CHANGE_ME.
# Consumed by docker-compose.prod.yml; see docs/operations/dokploy-deploy.md.
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Every secret must be DISTINCT.

# --- Domains (bare hostnames: no scheme, no port) ---
HUB_PRIMARY_DOMAIN=hub.majie.ai
HUB_REPORTS_DOMAIN=reports.hub.majie.ai

# --- Database (Dokploy-managed Postgres, INTERNAL connection string) ---
# Change the scheme to postgresql+asyncpg:// . The URL must contain "hub"
# (database or user name), or scripts/manage_customer.py refuses to run.
DATABASE_URL=postgresql+asyncpg://hub:CHANGE_ME@CHANGE_ME_INTERNAL_HOST:5432/hub

# --- Secrets (>=32 bytes each, all different) ---
HUB_SESSION_SECRET=CHANGE_ME
HUB_IFRAME_JWT_SECRET=CHANGE_ME
HUB_MAGIC_LINK_HASH_SECRET=CHANGE_ME
HUB_INTERNAL_TOKEN=CHANGE_ME

# --- Object storage (MinIO in the stack) ---
MINIO_ROOT_USER=spectrana
MINIO_ROOT_PASSWORD=CHANGE_ME
AWS_S3_BUCKET=hub-reports-prod

# --- SMTP (magic-link email) — Brevo relay; copy USER/PASS from local .env ---
# The sender below must be a verified sender (or majie.ai a verified domain) in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_STARTTLS=true

# --- Email branding ---
HUB_EMAIL_FROM=marginleak@majie.ai
HUB_EMAIL_BRAND_NAME="MarginLeak Report"

# --- Optional ---
# LOG_LEVEL=INFO
