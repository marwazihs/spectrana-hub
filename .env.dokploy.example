# Dokploy → Compose app → Environment. Paste, then fill every empty value.
# Consumed by docker-compose.prod.yml; see docs/operations/dokploy-deploy.md.
# Secrets are left blank on purpose: never commit real or placeholder
# credentials here. docker-compose.prod.yml uses ${VAR:?}, so any value
# left empty fails the deploy with an error naming the variable.
#
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Every secret must be DISTINCT.

# --- Domains (bare hostnames: no scheme, no port) ---
HUB_PRIMARY_DOMAIN=hub.majie.ai
HUB_REPORTS_DOMAIN=reports.hub.majie.ai

# --- Database (Dokploy-managed Postgres) ---
# Paste the INTERNAL connection string from Dokploy, then:
#   - change the scheme from postgresql to postgresql+asyncpg
#   - make sure the database or user name contains "hub"
#     (scripts/manage_customer.py refuses to run otherwise)
DATABASE_URL=

# --- Secrets (>=32 bytes each, all different) ---
HUB_SESSION_SECRET=
HUB_IFRAME_JWT_SECRET=
HUB_MAGIC_LINK_HASH_SECRET=
HUB_INTERNAL_TOKEN=

# --- Object storage (MinIO in the stack) ---
MINIO_ROOT_USER=spectrana
MINIO_ROOT_PASSWORD=
AWS_S3_BUCKET=hub-reports-prod

# --- SMTP (magic-link email): Brevo relay ---
# Copy SMTP_USER and SMTP_PASS from your local .env.
# The sender below must be a verified sender (or majie.ai a verified domain) in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true

# --- Email branding ---
HUB_EMAIL_FROM=marginleak@majie.ai
HUB_EMAIL_BRAND_NAME="MarginLeak Report"

# --- Optional ---
# LOG_LEVEL=INFO
