<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Your {{ brand }} report link</title>
</head>
<body style="margin:0;padding:24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;background:#fafafa;color:#111;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:520px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5;border-radius:8px;">
    <tr>
      <td style="padding:32px;">
        <p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;">Hi,</p>
        <p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;">You requested a link to view your <strong>{{ brand }}</strong> report.</p>
        <p style="margin:0 0 24px 0;">
          <a href="{{ link }}" style="display:inline-block;background:#111;color:#fff;text-decoration:none;padding:12px 20px;border-radius:6px;font-size:15px;">Open the report</a>
        </p>
        <p style="margin:0 0 8px 0;font-size:13px;color:#666;line-height:1.5;">Valid for {{ ttl_minutes }} minutes. Single use.</p>
        <p style="margin:0 0 16px 0;font-size:13px;color:#666;line-height:1.5;">If the button doesn't work, paste this URL into your browser:<br><span style="word-break:break-all;color:#333;">{{ link }}</span></p>
        <hr style="border:none;border-top:1px solid #e5e5e5;margin:24px 0;">
        <p style="margin:0;font-size:12px;color:#888;line-height:1.5;">If you didn't request this, you can ignore this email — no one can use the link without it.</p>
      </td>
    </tr>
  </table>
</body>
</html>
