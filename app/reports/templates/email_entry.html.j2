<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ brand }} — sign in to view this report</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
    body { margin: 0; min-height: 100dvh; display: grid; place-items: center; background: #f7f7f5; color: #1a1a1a; }
    main { width: 100%; max-width: 420px; padding: 24px; }
    h1 { font-size: 1.25rem; margin: 0 0 8px; }
    p { margin: 0 0 16px; color: #555; line-height: 1.5; }
    form { display: grid; gap: 12px; }
    input[type=email] { padding: 12px; border: 1px solid #ccc; border-radius: 6px; font: inherit; }
    button { padding: 12px; border: 0; border-radius: 6px; background: #1a1a1a; color: #fff; font: inherit; cursor: pointer; }
    .status { padding: 12px; border-radius: 6px; background: #eef; color: #224; font-size: 0.95rem; }
  </style>
</head>
<body>
  <main>
    <h1>{{ brand }} report</h1>
    {%- if submitted %}
    <p class="status">If this email is on file, a sign-in link has been sent. It expires in {{ ttl_minutes }} minutes.</p>
    {%- else %}
    <p>Enter your email to receive a sign-in link.</p>
    <form method="post" action="/r/{{ report_id }}/request-link">
      <input type="email" name="email" required autocomplete="email" placeholder="you@example.com">
      <button type="submit">Send link</button>
    </form>
    {%- endif %}
  </main>
</body>
</html>
