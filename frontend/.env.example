# Hub backend (FastAPI) — base URL the viewer calls server-to-server.
# In dev: http://localhost:8000. In prod: https://api.<domain>.
HUB_API_BASE_URL=http://localhost:8000

# Shared secret for /internal/* endpoints. Must match HUB_INTERNAL_TOKEN on
# the Hub side. Minimum 32 bytes; never expose to the browser.
HUB_INTERNAL_TOKEN=

# Iframe content origin (separate hostname in prod). Used to build the
# <iframe src> URL on the chrome page.
NEXT_PUBLIC_HUB_REPORTS_DOMAIN=reports.localhost:8000

# Cookie attribute toggles. In local HTTP dev set HUB_COOKIE_SECURE=0;
# in any HTTPS deploy leave unset (defaults to secure).
HUB_COOKIE_SECURE=1
